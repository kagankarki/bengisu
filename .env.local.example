# Firebase yapılandırması (İSTEĞE BAĞLI)
#
# Proje zaten çalışan bir Firebase yapılandırmasıyla geliyor (lib/firebase.ts
# içindeki varsayılanlar). Farklı bir Firebase projesine bağlanmak istersen
# bu dosyayı ".env.local" olarak kopyalayıp aşağıdaki değerleri doldur;
# bunlar varsayılanları geçersiz kılar.
#
# Not: Firebase web anahtarları GİZLİ DEĞİLDİR — güvenlik firestore.rules ile
# sağlanır. Bu yüzden repoya eklenmeleri sorun değildir.

# Harita ücretsiz ve anahtarsızdır (Leaflet + Esri altlık + OpenStreetMap arama);
# harita için herhangi bir ayar gerekmez.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
